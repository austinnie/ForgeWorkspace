# ============================================================
# ForgeWorkspace 专属忽略规则
# ============================================================

# 1. 全局输出目录 (所有 App 生成的图片、临时文件)
output/
apps/*/output/
temp_gather/

# 2. 敏感配置 (绝对不要提交 API Key！)
.env
.env.local
*.local.json

# 3. Python 运行时缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 4. 虚拟环境 (不要提交几百MB的 venv)
venv/
.venv/
env/
ENV/

# 5. IDE 和编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~

# 6. 日志和临时文件
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# 7. AI 模型文件 (如果以后在 shared_assets 放模型，必须忽略)
*.safetensors
*.ckpt
*.bin
*.pth
*.onnx

# 8. 代码收集工具生成的临时报告 (如果有的话)
project_snapshot_*.txt